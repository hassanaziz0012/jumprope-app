{
    "expo": {
        "name": "Jumprope Tracker",
        "slug": "jumprope-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "jumprope-app",
        "userInterfaceStyle": "dark",
        "backgroundColor": "#0a0a0a",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.hassan0012.jumpropeapp"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/icon.png",
                "backgroundImage": "./assets/images/icon.png",
                "monochromeImage": "./assets/images/icon.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.hassan0012.jumpropeapp"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/icon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            "expo-sqlite",
            "@react-native-community/datetimepicker",
            [
                "expo-build-properties",
                {
                    "android": {
                        "extraProguardRules": "-keep class com.horcrux.svg.** { *; }"
                    }
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "04d7820c-4f1d-4e87-a27a-74879d9382ae"
            }
        },
        "owner": "hassan0012",
        "updates": {
            "url": "https://u.expo.dev/04d7820c-4f1d-4e87-a27a-74879d9382ae"
        },
        "runtimeVersion": {
            "policy": "appVersion"
        }
    }
}
